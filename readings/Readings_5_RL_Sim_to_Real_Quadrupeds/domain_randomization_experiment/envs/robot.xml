<!--
  Planar two-legged "bounding" robot (a 2D cut through a quadruped):
  a torso with a back leg and a front leg, each with a hip and a knee.
  The robot moves in the x-z plane only (rootx / rootz slide, rooty hinge).
  Actuators are plain torque motors; the PD controller lives in Python
  (envs/walker_env.py), so ctrl is a torque in Nm. The wide ctrlrange is a
  safety net only - the real torque limit is applied in Python so that
  "motor strength" can scale it.
-->
<mujoco model="planar_bounder">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.05" armature="0.01" limited="true"/>
    <geom contype="1" conaffinity="0" condim="3" friction="0.8 0.1 0.1" rgba="0.85 0.6 0.35 1"/>
    <motor ctrllimited="true" ctrlrange="-50 50" gear="1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.15 0.2 0.25" width="256" height="256"/>
    <material name="grid" texture="grid" texrepeat="40 40" reflectance="0.1"/>
  </asset>

  <visual>
    <global offwidth="960" offheight="540"/>
  </visual>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="200 3 0.1" material="grid" contype="1" conaffinity="1" friction="0.8 0.1 0.1"/>

    <body name="torso" pos="0 0 0.42">
      <camera name="track" mode="trackcom" pos="0 -2.5 0.3" xyaxes="1 0 0 0 0 1"/>
      <joint name="rootx" type="slide" axis="1 0 0" limited="false" damping="0" armature="0"/>
      <joint name="rootz" type="slide" axis="0 0 1" limited="false" damping="0" armature="0"/>
      <joint name="rooty" type="hinge" axis="0 1 0" limited="false" damping="0" armature="0"/>
      <geom name="torso" type="capsule" fromto="-0.3 0 0 0.3 0 0" size="0.05" mass="6.0" rgba="0.3 0.45 0.75 1"/>
      <geom name="head" type="sphere" pos="0.34 0 0.03" size="0.06" mass="0.5" rgba="0.3 0.45 0.75 1"/>

      <!-- back leg -->
      <body name="bthigh" pos="-0.28 0 0">
        <joint name="bhip" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom name="bthigh" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.035" mass="1.0"/>
        <body name="bshin" pos="0 0 -0.2">
          <joint name="bknee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom name="bshin" type="capsule" fromto="0 0 0 0 0 -0.18" size="0.03" mass="0.5"/>
          <geom name="bfoot" type="sphere" pos="0 0 -0.18" size="0.035" mass="0.1" rgba="0.2 0.2 0.2 1"/>
        </body>
      </body>

      <!-- front leg -->
      <body name="fthigh" pos="0.28 0 0">
        <joint name="fhip" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom name="fthigh" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.035" mass="1.0"/>
        <body name="fshin" pos="0 0 -0.2">
          <joint name="fknee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom name="fshin" type="capsule" fromto="0 0 0 0 0 -0.18" size="0.03" mass="0.5"/>
          <geom name="ffoot" type="sphere" pos="0 0 -0.18" size="0.035" mass="0.1" rgba="0.2 0.2 0.2 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="bhip_motor" joint="bhip"/>
    <motor name="bknee_motor" joint="bknee"/>
    <motor name="fhip_motor" joint="fhip"/>
    <motor name="fknee_motor" joint="fknee"/>
  </actuator>
</mujoco>
