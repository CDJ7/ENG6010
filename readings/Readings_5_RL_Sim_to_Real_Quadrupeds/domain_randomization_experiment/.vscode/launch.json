{
    // Run configurations for the Domain Randomization Experiment.
    // Select the .venv interpreter first (Ctrl+Shift+P -> "Python: Select Interpreter").
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Quick test (smoke test, ~3 min)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/quick_test.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "2. Train fixed",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--mode", "fixed"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "3. Train randomized",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--mode", "randomized"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "4. Evaluate + Plots",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate_and_plot.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "5. Watch (pick model + condition)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/watch.py",
            "args": ["--model", "${input:model}", "--condition", "${input:condition}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "6. Plots only (from saved results)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/plot_results.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "Which controller?",
            "options": ["fixed", "randomized"],
            "default": "fixed"
        },
        {
            "id": "condition",
            "type": "pickString",
            "description": "Which test condition?",
            "options": ["nominal", "low_friction", "high_friction", "heavy", "light", "weak_motors", "pseudo_real"],
            "default": "low_friction"
        }
    ]
}
